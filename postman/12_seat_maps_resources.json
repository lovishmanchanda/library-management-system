    {
      "name": "Read the seat map",
      "item": [
        {
          "name": "The list says which rooms have a seat map",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resources"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const list = pm.response.json().data;",
                  "const mapRoom = list.find(function (r) { return r.id === pm.collectionVariables.get('roomId'); });",
                  "const plainRoom = list.find(function (r) { return r.id === pm.collectionVariables.get('plainId'); });",
                  "pm.test('hasSeatMap and seatCount, but not the whole map', function () {",
                  "  pm.expect(mapRoom.hasSeatMap).to.eql(true);",
                  "  pm.expect(mapRoom.seatCount).to.eql(12);",
                  "  pm.expect(mapRoom).to.not.have.property('layout');",
                  "  pm.expect(plainRoom.hasSeatMap).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "One room has its seat map",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resources/{{roomId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resources",
                "{{roomId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const layout = pm.response.json().data.layout;",
                  "pm.test('3 rows, 4 columns and 12 seats with row, col and label', function () {",
                  "  pm.expect(layout.rows).to.eql(3);",
                  "  pm.expect(layout.cols).to.eql(4);",
                  "  pm.expect(layout.seats.length).to.eql(12);",
                  "  pm.expect(layout.seats[5]).to.have.property('label');",
                  "});"
                ]
              }
            }
          ]
        },
