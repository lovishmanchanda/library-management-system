{
  "info": {
    "name": "Atlas Room - 12 Seat Maps in Resources",
    "description": "Phase 4. Needs the seat map in the resource routes (Krishna), the seat assignment and the seat map route (Lovish) and the seat wishes (Jasandeep) merged. It uses a random far date, so it can be run again and again. It cleans up after itself, but the run history keeps one allocation run record.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "date",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "plainId",
      "value": ""
    },
    {
      "key": "aarav1",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@university.edu\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', data.token);",
                  "// a new far away date for every run, so the allocation run of an old date cannot disturb it",
                  "const month = 1 + Math.floor(Math.random() * 12);",
                  "const day = 1 + Math.floor(Math.random() * 28);",
                  "pm.collectionVariables.set('date', '2029-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login student 1 (Aarav)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.sharma@university.edu\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ]
        }
      ]
