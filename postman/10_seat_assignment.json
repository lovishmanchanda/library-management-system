        {
          "name": "Admin runs the allocation (both get their seats)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/allocate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "allocate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{date}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const rows = pm.response.json().data.decisions;",
                  "const priya = rows.find(function (d) { return d.id === pm.collectionVariables.get('priya1'); });",
                  "const aarav = rows.find(function (d) { return d.id === pm.collectionVariables.get('aarav1'); });",
                  "pm.test('Both are confirmed and the decisions list the seats', function () {",
                  "  pm.expect(priya.status).to.eql('confirmed');",
                  "  pm.expect(aarav.status).to.eql('confirmed');",
                  "  pm.expect(priya.seats.length).to.eql(1);",
                  "  pm.expect(aarav.seats.length).to.eql(3);",
                  "});",
                  "pm.test('No seat is given twice and the group of 3 sits in one row', function () {",
                  "  const all = priya.seats.concat(aarav.seats);",
                  "  pm.expect(new Set(all).size).to.eql(4);",
                  "  pm.expect(aarav.seats.every(function (l) { return l[0] === aarav.seats[0][0]; })).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('taken4', JSON.stringify(priya.seats.concat(aarav.seats).sort()));"
                ]
              }
            }
          ]
        }
      ]
    },
