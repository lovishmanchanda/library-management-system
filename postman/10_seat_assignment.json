    {
      "name": "Seat map route",
      "item": [
        {
          "name": "Seat map of the empty room",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resources/{{roomId}}/seats?date={{date}}&startTime=10:00&endTime=11:00",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resources",
                "{{roomId}}",
                "seats"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "startTime",
                  "value": "10:00"
                },
                {
                  "key": "endTime",
                  "value": "11:00"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json().data;",
                  "pm.test('2 rows, 5 columns, 8 seats named A1 to B4, none taken', function () {",
                  "  pm.expect(data.rows).to.eql(2);",
                  "  pm.expect(data.cols).to.eql(5);",
                  "  pm.expect(data.seats.map(function (s) { return s.label; }).join(',')).to.eql('A1,A2,A3,A4,B1,B2,B3,B4');",
                  "  data.seats.forEach(function (s) { pm.expect(s.taken).to.eql(false); });",
                  "});",
                  "pm.test('The aisle (column 2) is a gap: A3 is in column 3', function () {",
                  "  const a3 = data.seats.find(function (s) { return s.label === 'A3'; });",
                  "  pm.expect(a3.col).to.eql(3);",
                  "});"
                ]
              }
            }
          ]
        },
